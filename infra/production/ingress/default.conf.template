limit_req_zone $binary_remote_addr zone=prd_api:10m rate=10r/s;

server {
    listen 8080;
    server_name ${PRD_AGENT_SERVER_NAME};
    if ($host != "${PRD_AGENT_SERVER_NAME}") { return 421; }
    return 301 https://$host$request_uri;
}

server {
    listen 8443 ssl;
    server_name ${PRD_AGENT_SERVER_NAME};
    if ($host != "${PRD_AGENT_SERVER_NAME}") { return 421; }

    ssl_certificate /run/secrets/tls_certificate;
    ssl_certificate_key /run/secrets/tls_private_key;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    client_max_body_size 256k;
    large_client_header_buffers 2 8k;

    auth_basic "PRD Agent";
    auth_basic_user_file /run/secrets/basic_auth_htpasswd;

    location = /ingress-health {
        auth_basic off;
        access_log off;
        return 200 "ok\n";
    }

    location /backend/ {
        limit_req zone=prd_api burst=20 nodelay;
        proxy_pass http://go-api:8080/;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-PRD-Authenticated-User $remote_user;
        proxy_set_header X-PRD-Proxy-Secret "${PRD_AGENT_PROXY_SECRET}";
        proxy_buffering off;
        proxy_read_timeout 65s;
    }

    location / {
        proxy_pass http://web:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
