PRD_AGENT_ENVIRONMENT=local
PRD_AGENT_DATABASE_DSN=postgresql://prd_agent:prd_agent_local_only@127.0.0.1:5432/prd_agent
PRD_AGENT_AGENT_LOOP_MODE=langgraph

# Optional in local; required in staging/production. The key file is ignored by Git.
PRD_AGENT_LLM_PROVIDER=deepseek
PRD_AGENT_LLM_BASE_URL=https://api.deepseek.com
PRD_AGENT_LLM_MODEL=deepseek-v4-pro
PRD_AGENT_LLM_API_KEY_FILE=infra/production/secrets/deepseek_api_key
PRD_AGENT_LLM_TIMEOUT_SECONDS=90
PRD_AGENT_LLM_CONNECT_TIMEOUT_SECONDS=5
PRD_AGENT_LLM_MAX_OUTPUT_TOKENS=4096
PRD_AGENT_LLM_MAX_ITERATIONS=8
PRD_AGENT_LLM_MAX_TOOL_CALLS=8
PRD_AGENT_LLM_NO_PROGRESS_LIMIT=2
PRD_AGENT_LLM_MAX_REPLANS=1
PRD_AGENT_LLM_RUN_TOKEN_BUDGET=24000
PRD_AGENT_LLM_MAX_TRANSPORT_RETRIES=2
PRD_AGENT_LLM_ALLOWED_HOSTS=api.deepseek.com

# Local-only Feishu values. Production accepts the corresponding *_FILE
# variables mounted as Docker secrets.
PRD_AGENT_FEISHU_APP_ID=cli_xxx
PRD_AGENT_FEISHU_APP_SECRET=replace-me

# One fixed Wiki Docx node used for both reads and in-place PRD exports.
PRD_AGENT_FEISHU_DOCUMENT_HOST=your-tenant.feishu.cn
PRD_AGENT_FEISHU_WIKI_NODE_TOKEN=replace-me

# Local-only values. Generate each independently with: openssl rand -hex 32
PRD_AGENT_EXPORT_CONFIRMATION_SECRET=replace-me
PRD_AGENT_EXTERNAL_ID_ENCRYPTION_KEY=replace-me

# Production Compose host configuration (no enterprise identity platform).
PRD_AGENT_PUBLIC_ORIGIN=https://prd.example.com
PRD_AGENT_SERVER_NAME=prd.example.com
PRD_AGENT_ALLOWED_USERS=alice
PRD_AGENT_DEFAULT_TENANT=default
PRD_AGENT_FIXED_REPOSITORY_BINDING_ID=github:dante26979-droid/PRD-Agent
PRD_AGENT_FIXED_REPOSITORY=dante26979-droid/PRD-Agent
PRD_AGENT_FIXED_REPOSITORY_REVISION=replace-with-full-commit-sha
PRD_AGENT_REPOSITORY_REFRESH_INTERVAL_SECONDS=30
PRD_AGENT_SECRET_GID=2000
PRD_AGENT_BACKUP_DIRECTORY=/absolute/off-host/or-synced/backup/path
PRD_AGENT_BACKUP_INTERVAL_SECONDS=900
